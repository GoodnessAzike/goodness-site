---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import AboutTalk from '../components/AboutTalk.astro';
import LifePaths from '../components/LifePaths.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';
import { themeSongs, favouriteQuote } from '../data/songs';

// On the live site, only show songs that have a title, and only stages that have songs
const stages = themeSongs
  .map((st) => ({ ...st, songs: st.songs.filter((t) => import.meta.env.DEV || t.song) }))
  .filter((st) => st.songs.length > 0);
---
<Base title="About" description={`About ${site.name}, plus contact links and CV.`}>
  <header class="page-head">
    <h1>About</h1>
  </header>

  <div class="about">
    <section class="bio" aria-label="Bio">
      {site.bio.map((para) => para ? <p>{para}</p> : <Placeholder block>short bio, two or three sentences</Placeholder>)}
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <span class="stamp" aria-hidden="true">Open to work</span>
      <h2 id="contact-title">Get in touch</h2>
      {site.openTo && <p class="open-to">{site.openTo}</p>}
      <ul>
        <li>
          {site.linkedin
            ? <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            : <Placeholder>LinkedIn link</Placeholder>}
        </li>
        <li>
          {site.email
            ? <a href={`mailto:${site.email}`}>{site.email}</a>
            : <Placeholder>email address</Placeholder>}
        </li>
      </ul>
      <a class="button cv" href={site.cv} download>Download my CV (PDF)</a>
    </section>
  </div>

  <LifePaths />

  <Testimonials />

  <AboutTalk />

  {site.outsideWork.length > 0 && (
    <section class="outside" aria-labelledby="outside-title">
      <h2 id="outside-title">Outside work</h2>
      <ul>
        {site.outsideWork.map((item) => typeof item === 'string'
          ? <li>{item}</li>
          : <li>{item.text}{item.link && <a class="note-link" href={item.link} target="_blank" rel="noopener">{item.linkText ?? 'See more'}</a>}</li>)}
      </ul>
      {site.aim && <p class="aim">{site.aim}</p>}
    </section>
  )}

  {stages.length > 0 && (
  <section class="songs" aria-labelledby="songs-title">
    <div class="songs-head">
      <h2 id="songs-title">Songs I listen to</h2>
      <p>The soundtrack so far, by life stage.{stages.some((st) => st.songs.some((t) => t.url)) && ' Links open on Spotify or YouTube.'}</p>
    </div>

    <ol class="stages">
      {stages.map((stage) => (
        <li class="stage">
          <h3>{stage.stage}{stage.stage === 'Now' && <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>}</h3>
          <ul class="tracks">
            {stage.songs.map((t) => (
              <li class="track">
                <div class="track-name">
                  {t.song && t.url
                    ? <a class="song-title" href={t.url} target="_blank" rel="noopener">{t.song}</a>
                    : t.song
                      ? <span class="song-title">{t.song}</span>
                      : <Placeholder>song to be chosen</Placeholder>}
                  <span class="artist">{t.artist}</span>
                </div>
                {t.note
                  ? <p class="note">{t.note}</p>
                  : import.meta.env.DEV && <p class="note"><Placeholder>one-line note</Placeholder></p>}
                {!t.url && import.meta.env.DEV && <p class="note"><Placeholder>Spotify or YouTube link</Placeholder></p>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    {favouriteQuote.text && (
      <figure class="fav">
        <blockquote><p>{favouriteQuote.text}</p></blockquote>
        <figcaption>{favouriteQuote.by}</figcaption>
      </figure>
    )}
  </section>
  )}
</Base>

<style>
  .about {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } }
  .bio { display: grid; gap: 16px; font-size: 1.1875rem; }

  .contact { position: relative; border: 1px solid var(--line); background: var(--ink-raised); padding: 24px; display: grid; gap: 16px; justify-items: start; }
  /* rubber stamp, slapped on slightly crooked */
  .stamp {
    position: absolute; top: -18px; right: -10px;
    padding: 4px 12px 2px;
    border: 3px double var(--redline);
    color: var(--redline);
    font-family: var(--font-display); font-weight: 800; font-size: 1.375rem; letter-spacing: 0.04em;
    transform: rotate(8deg);
    opacity: 0.9;
    background: rgba(10, 26, 47, 0.6);
    pointer-events: none;
  }
  .contact h2 { font-size: 1.75rem; font-weight: 700; }
  .open-to { font-weight: 700; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .contact a:not(.button) { overflow-wrap: anywhere; }

  .outside { margin-top: clamp(64px, 10vw, 112px); display: grid; gap: 24px; }
  .outside ul {
    list-style: none; margin: 0; padding: 8px 0 0;
    display: grid; gap: 28px 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  /* taped notes, each a little crooked */
  .outside li {
    position: relative;
    background: #fff4b8; color: #1f2328;
    padding: 22px 18px 20px;
    font-size: 1rem; line-height: 1.5;
    box-shadow: 3px 5px 0 rgba(0, 0, 0, 0.25);
    transform: rotate(-1.5deg);
  }
  .outside li:nth-child(2) { transform: rotate(1.2deg); background: #ffe3e0; }
  .outside li:nth-child(3) { transform: rotate(-0.6deg); background: #e3f1ff; }
  .outside li:nth-child(4) { transform: rotate(1.8deg); background: #e6f4d7; }
  .note-link {
    display: block; margin-top: 10px;
    color: #1f2328; font-family: var(--font-hand); font-weight: 700; font-size: 1.0625rem;
    text-decoration-color: #e03131; text-decoration-thickness: 2px;
  }
  .note-link:hover { color: #e03131; }
  .outside li::before {
    content: ''; position: absolute; top: -10px; left: 50%;
    width: 70px; height: 20px; margin-left: -35px;
    background: rgba(200, 210, 222, 0.75);
    transform: rotate(-3deg);
  }
  .aim { border-left: 3px solid var(--line); padding: 4px 0 4px 16px; color: var(--muted); font-style: italic; }

  .songs { margin-top: clamp(64px, 10vw, 112px); }
  .songs-head { display: grid; gap: 12px; margin-bottom: 32px; }
  .songs-head p { color: var(--muted); }

  .stages { list-style: none; margin: 0; padding: 0; display: grid; }
  .stage {
    display: grid;
    grid-template-columns: minmax(150px, 220px) 1fr;
    gap: 12px 32px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .stage:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) { .stage { grid-template-columns: 1fr; } }
  .stage h3 { color: var(--muted); display: flex; align-items: flex-end; align-self: start; gap: 10px; }
  /* little "now playing" bars */
  .eq { display: inline-flex; align-items: flex-end; gap: 3px; height: 18px; margin-bottom: 4px; }
  .eq i { width: 4px; background: var(--signal); animation: eq 0.9s ease-in-out infinite alternate; }
  .eq i:nth-child(1) { height: 40%; animation-delay: -0.3s; }
  .eq i:nth-child(2) { height: 100%; animation-delay: -0.6s; }
  .eq i:nth-child(3) { height: 65%; }
  @keyframes eq { from { transform: scaleY(0.3); } to { transform: scaleY(1); } }
  .eq i { transform-origin: bottom; }

  .tracks { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .track { display: grid; gap: 6px; }
  .track-name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .song-title { font-family: var(--font-display); font-weight: 700; font-size: 1.625rem; line-height: 1.1; }
  .artist { color: var(--muted); }
  .note { font-size: 1rem; }

  .fav { margin: clamp(40px, 6vw, 64px) 0 0; display: grid; gap: 14px; }
  .fav blockquote { margin: 0; }
  .fav p {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.05;
    max-width: 20ch;
    text-wrap: balance;
  }
  .fav figcaption { color: var(--muted); }
</style>
