---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const episodes = (await getCollection('episodes')).sort(
  (a, b) => b.data.season - a.data.season || b.data.episode - a.data.episode,
);
const rendered = await Promise.all(
  episodes.map(async (ep) => ({ ep, Content: (await render(ep)).Content })),
);
// Every season that has episodes or is listed in site.ts, newest first.
// A listed season with no episodes yet is "coming soon".
const seasonNumbers = [...new Set([
  ...episodes.map((ep) => ep.data.season),
  ...Object.keys(site.seasons).map(Number),
])].sort((a, b) => b - a);
const seasons = seasonNumbers.map((n) => {
  const items = rendered.filter(({ ep }) => ep.data.season === n);
  const total = site.seasons[n]?.episodes;
  const latest = items[0]?.ep; // items are newest first
  return { n, title: site.seasons[n]?.title, items, soon: items.length === 0, total, latest };
});
// Open on the newest season that has episodes
const current = seasons.find((s) => !s.soon)?.n ?? seasons[0]?.n;
const label = (s: (typeof seasons)[number]) =>
  `Season ${s.n}${s.title ? `: ${s.title}` : ''}`;
const newestId = episodes[0]?.id;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Episodes" description="A weekly learning log, newest first.">
  <header class="page-head">
    <h1>Episodes</h1>
    <p>A weekly log of what I am learning, newest first. Each one ends with what I am learning next.</p>
  </header>

  {seasons.length > 0 && (
    <div class="picker">
      <label for="season-pick" class="visually-hidden">Choose a season</label>
      <select id="season-pick" data-season-pick>
        {seasons.map((s) => (
          <option value={s.n} selected={s.n === current}>
            {label(s)}{s.soon ? ' (soon)' : ''}
          </option>
        ))}
      </select>
      <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </div>
  )}
  <button type="button" class="all-toggle" data-all hidden>Expand all</button>

  {seasons.map((season) => (
    <section class="season-block" aria-labelledby={`season-${season.n}`} data-season={season.n}>
      <h2 class="season" id={`season-${season.n}`}>{label(season)}</h2>
      {!season.soon && (
        <div class="recap">
          {season.total && (
            <div class="progress" role="img" aria-label={`${season.items.length} of ${season.total} episodes out${season.items.length < season.total ? ', finale next' : ', season complete'}`}>
              <ol class="ticks" aria-hidden="true">
                {Array.from({ length: season.total }, (_, i) => {
                  const done = i < season.items.length;
                  const next = i === season.items.length;
                  const finale = i === season.total! - 1;
                  return (
                    <li class:list={['tick', { done, next, finale }]}>
                      <span class="bar"></span>
                      <span class="num">{finale ? 'Finale' : `Ep ${i + 1}`}</span>
                    </li>
                  );
                })}
              </ol>
              <p class="count">{season.items.length} of {season.total} out</p>
            </div>
          )}
          {season.latest && (
            <p class="previously">
              <span class="prev-label">Previously on {season.title ?? `Season ${season.n}`}:</span>{' '}
              {season.latest.data.title}.{' '}
              <span class="prev-next">Next time: {season.latest.data.cliffhanger}</span>
            </p>
          )}
        </div>
      )}
      {season.soon ? (
        <div class="soon">
          <p class="soon-stamp">Coming soon</p>
          <p class="soon-title">{label(season)}</p>
          <p class="soon-note">Starts after the Season 1 finale.</p>
          <button type="button" class="button" data-back>Back to Season {seasons.find((x) => !x.soon)?.n}</button>
        </div>
      ) : (
      <ol class="log" reversed>
        {season.items.map(({ ep, Content }) => (
          <li class:list={['entry', { newest: ep.id === newestId }]}>
            <div class="marker" aria-hidden="true"></div>
            <article>
              <details class="ep" open={ep.id === newestId} data-ep>
              <summary>
                <span class="sum-text">
                  <span class="code">Season {ep.data.season}, Episode {ep.data.episode}</span>
                  <h3>{ep.data.title}</h3>
                  {ep.data.subtitle && <span class="subtitle">{ep.data.subtitle}</span>}
                  <span class="meta">
                    <time datetime={ep.data.date.toISOString().slice(0, 10)}>{fmt.format(ep.data.date)}</time>
                    {ep.data.sample && <span class="sample-tag">Sample, replace me</span>}
                  </span>
                </span>
                <svg class="ep-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class="ep-body">
              <div class="notes"><Content /></div>
              <p class="cliff hand"><span class="cliff-label">Next time:</span> {ep.data.cliffhanger}</p>
              <div class="actions">
                <button
                  type="button"
                  class="listen"
                  data-listen
                  data-audio={ep.data.audio}
                  data-say={[ep.data.title, ep.data.subtitle, ep.body, `Next time: ${ep.data.cliffhanger}`].filter(Boolean).join('. ').replace(/\.\./g, '.')}
                  aria-pressed="false"
                  hidden
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
                  <span data-listen-label>{ep.data.audio ? 'Listen in my voice' : 'Listen'}</span>
                </button>
                {ep.data.medium
                  ? <a class="button" href={ep.data.medium} target="_blank" rel="noopener">Read this episode on Medium</a>
                  : <span class="ph">Placeholder: Medium link</span>}
              </div>
              </div>
              </details>
            </article>
          </li>
        ))}
      </ol>
      )}
    </section>
  ))}
  {episodes.length === 0 && <p>No episodes yet. Add a Markdown file to src/content/episodes/ to start Season 1.</p>}
</Base>

<script>
  // Season picker: show one season at a time (all seasons stay visible without JavaScript)
  const pick = document.querySelector<HTMLSelectElement>('[data-season-pick]');
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-season]'));
  if (pick && blocks.length) {
    const showSeason = (n: string, scroll = false) => {
      blocks.forEach((b) => { b.hidden = b.dataset.season !== n; });
      pick.value = n;
      if (scroll) pick.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    const fromHash = location.hash.match(/^#season-(\d+)$/)?.[1];
    showSeason(fromHash && blocks.some((b) => b.dataset.season === fromHash) ? fromHash : pick.value);
    window.addEventListener('hashchange', () => {
      const n = location.hash.match(/^#season-(\d+)$/)?.[1];
      if (n && blocks.some((b) => b.dataset.season === n)) showSeason(n);
    });
    pick.addEventListener('change', () => {
      history.replaceState(null, '', `#season-${pick.value}`);
      showSeason(pick.value);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((b) =>
      b.addEventListener('click', () => {
        const first = pick.querySelector<HTMLOptionElement>('option:not([value="' + pick.value + '"])');
        const target = Array.from(pick.options).find((o) => !o.textContent!.includes('(soon)'));
        showSeason((target ?? first)!.value, true);
        history.replaceState(null, '', `#season-${pick.value}`);
      }),
    );
  }

  // Expand all / collapse all, for the season on screen
  const allBtn = document.querySelector<HTMLButtonElement>('[data-all]');
  if (allBtn) {
    const visibleEps = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-season]:not([hidden]) [data-ep]'));
    const sync = () => {
      const eps = visibleEps();
      allBtn.hidden = eps.length < 2;
      allBtn.textContent = eps.length && eps.every((d) => d.open) ? 'Collapse all' : 'Expand all';
    };
    allBtn.addEventListener('click', () => {
      const eps = visibleEps();
      const open = !eps.every((d) => d.open);
      eps.forEach((d) => { d.open = open; });
      sync();
    });
    document.querySelectorAll<HTMLDetailsElement>('[data-ep]').forEach((d) => d.addEventListener('toggle', sync));
    document.querySelector('[data-season-pick]')?.addEventListener('change', () => setTimeout(sync));
    window.addEventListener('hashchange', () => setTimeout(sync));
    document.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => setTimeout(sync)));
    sync();
  }

  import { unlockAudio } from '../scripts/unlock-audio';
  // Listen: plays the episode's own recording if it has one, otherwise reads it aloud
  // with the browser's built-in voice. Only one episode plays at a time.
  const synth = 'speechSynthesis' in window ? window.speechSynthesis : null;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-listen]'));
  let current: { btn: HTMLButtonElement; stop: () => void } | null = null;

  const setState = (btn: HTMLButtonElement, playing: boolean) => {
    btn.setAttribute('aria-pressed', String(playing));
    const label = btn.querySelector('[data-listen-label]')!;
    const own = Boolean(btn.dataset.audio);
    label.textContent = playing ? 'Stop' : own ? 'Listen in my voice' : 'Listen';
  };

  const pickVoice = () => {
    const voices = synth?.getVoices() ?? [];
    return voices.find((v) => v.lang === 'en-GB' && /female|serena|kate|sonia|libby|martha/i.test(v.name))
      ?? voices.find((v) => v.lang === 'en-GB')
      ?? voices.find((v) => v.lang.startsWith('en'));
  };

  buttons.forEach((btn) => {
    if (!btn.dataset.audio && !synth) return; // no way to play: keep the button hidden
    btn.hidden = false;

    btn.addEventListener('click', () => {
      unlockAudio();
      const wasMe = current?.btn === btn;
      current?.stop();
      if (wasMe) return;

      if (btn.dataset.audio) {
        const audio = new Audio(btn.dataset.audio);
        const stop = () => { audio.pause(); setState(btn, false); current = null; };
        audio.addEventListener('ended', stop);
        audio.play();
        current = { btn, stop };
      } else if (synth) {
        const u = new SpeechSynthesisUtterance(btn.dataset.say || '');
        const voice = pickVoice();
        if (voice) { u.voice = voice; u.lang = voice.lang; }
        u.rate = 0.98;
        const stop = () => { synth.cancel(); setState(btn, false); current = null; };
        u.onend = () => { if (current?.btn === btn) stop(); };
        synth.cancel();
        synth.speak(u);
        current = { btn, stop };
      }
      setState(btn, true);
    });
  });

  // Stop talking if the visitor leaves the page
  window.addEventListener('pagehide', () => current?.stop());
</script>

<style>
  .season-block + .season-block { margin-top: clamp(24px, 4vw, 40px); }
  .season-block[hidden] { display: none; }

  /* season progress + "Previously on" recap */
  .recap { display: grid; gap: 20px; margin-bottom: 36px; }
  .progress { display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; align-items: end; max-width: 720px; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; }
  .tick { display: grid; gap: 6px; }
  .tick .bar { height: 10px; background: var(--signal-ghost); border: 1px solid rgba(242, 179, 61, 0.25); }
  .tick.done .bar { background: var(--signal); border-color: var(--signal); }
  .tick.next .bar { animation: next-pulse 1.4s ease-in-out infinite; }
  .tick .num { font-size: 0.8125rem; color: var(--muted); }
  .tick.finale .num { font-family: var(--font-hand); font-weight: 700; color: var(--redline); font-size: 0.9375rem; }
  .count { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--signal); white-space: nowrap; }
  @keyframes next-pulse { 0%, 100% { background: var(--signal-ghost); } 50% { background: rgba(242, 179, 61, 0.45); } }

  .previously {
    max-width: var(--measure);
    border-left: 3px solid var(--line);
    padding: 4px 0 4px 16px;
    font-size: 1.0625rem;
  }
  .prev-label { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--paper); }
  .prev-next { font-family: var(--font-hand); color: var(--redline); font-weight: 700; }

  /* each episode opens and closes */
  .ep { width: 100%; }
  .ep summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start;
  }
  .ep summary::-webkit-details-marker { display: none; }
  .sum-text { display: grid; gap: 10px; justify-items: start; }
  .sum-text .code, .sum-text .subtitle, .sum-text .meta { display: block; }
  .sum-text .meta { display: flex; }
  .ep summary:hover h3 { text-decoration: underline; text-decoration-color: var(--line); text-decoration-thickness: 3px; text-underline-offset: 0.12em; }
  .ep-chev {
    width: 34px; height: 34px; margin-top: 26px; padding: 4px;
    border: 1.5px solid var(--line); fill: none; stroke: var(--signal); stroke-width: 2.5;
    transition: transform 0.25s ease;
  }
  .ep[open] .ep-chev { transform: rotate(180deg); }
  .ep summary:focus-visible { outline: 3px solid var(--signal); outline-offset: 6px; }
  .ep-body { display: grid; gap: 12px; justify-items: start; padding-top: 14px; }
  .ep:not([open]) + * { margin-top: 0; }

  .all-toggle {
    margin: 0 0 28px; min-height: 52px; padding: 6px 16px; vertical-align: top;
    border: 1.5px solid var(--line); background: transparent; color: var(--muted);
    font: inherit; font-size: 0.9375rem; font-weight: 700; cursor: pointer;
  }
  .all-toggle:hover { color: var(--paper); border-color: var(--paper); }
  .all-toggle[hidden] { display: none; }

  /* Netflix-style season dropdown */
  .picker { position: relative; display: inline-block; margin: 0 14px 32px 0; max-width: 100%; vertical-align: top; }
  @media (max-width: 560px) { .picker { display: block; margin: 0 0 12px; } .picker select { width: 100%; font-size: 1.1875rem; } .all-toggle { min-height: 44px; } }
  .picker select {
    appearance: none; -webkit-appearance: none;
    max-width: 100%;
    padding: 12px 52px 12px 18px;
    background: var(--ink-raised); color: var(--paper);
    border: 1.5px solid var(--line);
    font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 3.4vw, 1.625rem);
    cursor: pointer;
  }
  .picker select:hover { border-color: var(--paper); }
  .picker .chev { position: absolute; right: 16px; top: 50%; width: 22px; height: 22px; margin-top: -11px; fill: none; stroke: var(--signal); stroke-width: 2.5; pointer-events: none; }
  /* with the dropdown showing the season name, hide the repeated heading for sighted users */
  .picker ~ .season-block .season { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* coming soon teaser */
  .soon {
    position: relative; overflow: hidden;
    border: 1px solid var(--line); background: var(--ink-raised);
    padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 48px);
    display: grid; gap: 14px; justify-items: start;
  }
  .soon-stamp {
    border: 3px double var(--redline); color: var(--redline);
    padding: 2px 12px; transform: rotate(-4deg);
    font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: 0.04em;
  }
  .soon-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.25rem, 7vw, 4.5rem); line-height: 0.95; }
  .soon-note { color: var(--muted); }
  .season { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 28px; }
  article h3 { font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 800; line-height: 0.95; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0 clamp(14px, 3vw, 28px);
    padding-bottom: clamp(28px, 4vw, 40px);
  }
  /* timeline rail */
  .entry::before {
    content: '';
    position: absolute;
    left: 13px; top: 14px; bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .entry:last-child::before { display: none; }
  .marker { width: 28px; height: 28px; border: 2px solid var(--line); background: var(--ink); position: relative; z-index: 1; }
  .entry.newest .marker { border-color: var(--signal); background: var(--signal-ghost); }

  article { display: grid; gap: 12px; justify-items: start; min-width: 0; }
  .code { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--muted); line-height: 1.2; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; color: var(--muted); font-size: 1rem; }
  .subtitle { color: var(--muted); font-size: 1.0625rem; max-width: var(--measure); }
  .notes { max-width: var(--measure); }
  .notes :global(p + p) { margin-top: 0.8em; }
  .cliff {
    border-left: 3px solid var(--redline);
    padding: 2px 0 2px 14px;
    font-size: 1.25rem;
  }
  .cliff-label { font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .listen {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 48px; padding: 10px 18px;
    border: 1.5px solid var(--line); background: transparent; color: var(--paper);
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .listen:hover { border-color: var(--paper); }
  .listen svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .listen[aria-pressed='true'] { border-color: var(--signal); color: var(--signal); }
</style>
