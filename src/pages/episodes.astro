---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const episodes = (await getCollection('episodes')).sort(
  (a, b) => b.data.season - a.data.season || b.data.episode - a.data.episode,
);
const rendered = await Promise.all(
  episodes.map(async (ep) => ({ ep, Content: (await render(ep)).Content })),
);
// Group by season, newest season first
const seasons = [...new Set(episodes.map((ep) => ep.data.season))].map((n) => ({
  n,
  title: site.seasons[n]?.title,
  items: rendered.filter(({ ep }) => ep.data.season === n),
}));
const newestId = episodes[0]?.id;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Episodes" description="A weekly learning log, newest first.">
  <header class="page-head">
    <h1>Episodes</h1>
    <p>A weekly log of what I am learning, newest first. Each one ends with what I am learning next.</p>
  </header>

  {seasons.map((season) => (
    <section class="season-block" aria-labelledby={`season-${season.n}`}>
      <h2 class="season" id={`season-${season.n}`}>Season {season.n}{season.title ? `: ${season.title}` : ''}</h2>
      <ol class="log" reversed>
        {season.items.map(({ ep, Content }) => (
          <li class:list={['entry', { newest: ep.id === newestId }]}>
            <div class="marker" aria-hidden="true"></div>
            <article>
              <p class="code">Season {ep.data.season}, Episode {ep.data.episode}</p>
              <h3>{ep.data.title}</h3>
              {ep.data.subtitle && <p class="subtitle">{ep.data.subtitle}</p>}
              <p class="meta">
                <time datetime={ep.data.date.toISOString().slice(0, 10)}>{fmt.format(ep.data.date)}</time>
                {ep.data.sample && <span class="sample-tag">Sample, replace me</span>}
              </p>
              <div class="notes"><Content /></div>
              <p class="cliff hand"><span class="cliff-label">Next time:</span> {ep.data.cliffhanger}</p>
              <div class="actions">
                <button
                  type="button"
                  class="listen"
                  data-listen
                  data-audio={ep.data.audio}
                  data-say={[ep.data.title, ep.data.subtitle, ep.body, `Next time: ${ep.data.cliffhanger}`].filter(Boolean).join('. ').replace(/\.\./g, '.')}
                  aria-pressed="false"
                  hidden
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
                  <span data-listen-label>{ep.data.audio ? 'Listen in my voice' : 'Listen'}</span>
                </button>
                {ep.data.medium
                  ? <a class="button" href={ep.data.medium} target="_blank" rel="noopener">Read this episode on Medium</a>
                  : <span class="ph">Placeholder: Medium link</span>}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>
  ))}
  {episodes.length === 0 && <p>No episodes yet. Add a Markdown file to src/content/episodes/ to start Season 1.</p>}
</Base>

<script>
  import { unlockAudio } from '../scripts/unlock-audio';
  // Listen: plays the episode's own recording if it has one, otherwise reads it aloud
  // with the browser's built-in voice. Only one episode plays at a time.
  const synth = 'speechSynthesis' in window ? window.speechSynthesis : null;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-listen]'));
  let current: { btn: HTMLButtonElement; stop: () => void } | null = null;

  const setState = (btn: HTMLButtonElement, playing: boolean) => {
    btn.setAttribute('aria-pressed', String(playing));
    const label = btn.querySelector('[data-listen-label]')!;
    const own = Boolean(btn.dataset.audio);
    label.textContent = playing ? 'Stop' : own ? 'Listen in my voice' : 'Listen';
  };

  const pickVoice = () => {
    const voices = synth?.getVoices() ?? [];
    return voices.find((v) => v.lang === 'en-GB' && /female|serena|kate|sonia|libby|martha/i.test(v.name))
      ?? voices.find((v) => v.lang === 'en-GB')
      ?? voices.find((v) => v.lang.startsWith('en'));
  };

  buttons.forEach((btn) => {
    if (!btn.dataset.audio && !synth) return; // no way to play: keep the button hidden
    btn.hidden = false;

    btn.addEventListener('click', () => {
      unlockAudio();
      const wasMe = current?.btn === btn;
      current?.stop();
      if (wasMe) return;

      if (btn.dataset.audio) {
        const audio = new Audio(btn.dataset.audio);
        const stop = () => { audio.pause(); setState(btn, false); current = null; };
        audio.addEventListener('ended', stop);
        audio.play();
        current = { btn, stop };
      } else if (synth) {
        const u = new SpeechSynthesisUtterance(btn.dataset.say || '');
        const voice = pickVoice();
        if (voice) { u.voice = voice; u.lang = voice.lang; }
        u.rate = 0.98;
        const stop = () => { synth.cancel(); setState(btn, false); current = null; };
        u.onend = () => { if (current?.btn === btn) stop(); };
        synth.cancel();
        synth.speak(u);
        current = { btn, stop };
      }
      setState(btn, true);
    });
  });

  // Stop talking if the visitor leaves the page
  window.addEventListener('pagehide', () => current?.stop());
</script>

<style>
  .season-block + .season-block { margin-top: clamp(24px, 4vw, 40px); }
  .season { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 28px; }
  article h3 { font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 800; line-height: 0.95; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0 clamp(14px, 3vw, 28px);
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  /* timeline rail */
  .entry::before {
    content: '';
    position: absolute;
    left: 13px; top: 14px; bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .entry:last-child::before { display: none; }
  .marker { width: 28px; height: 28px; border: 2px solid var(--line); background: var(--ink); position: relative; z-index: 1; }
  .entry.newest .marker { border-color: var(--signal); background: var(--signal-ghost); }

  article { display: grid; gap: 12px; justify-items: start; min-width: 0; }
  .code { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--muted); line-height: 1.2; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; color: var(--muted); font-size: 1rem; }
  .subtitle { color: var(--muted); font-size: 1.0625rem; max-width: var(--measure); }
  .notes { max-width: var(--measure); }
  .notes :global(p + p) { margin-top: 0.8em; }
  .cliff {
    border-left: 3px solid var(--redline);
    padding: 2px 0 2px 14px;
    font-size: 1.25rem;
  }
  .cliff-label { font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .listen {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 48px; padding: 10px 18px;
    border: 1.5px solid var(--line); background: transparent; color: var(--paper);
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .listen:hover { border-color: var(--paper); }
  .listen svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .listen[aria-pressed='true'] { border-color: var(--signal); color: var(--signal); }
</style>
