---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Whiteboard from '../../components/Whiteboard.astro';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((ep) => ({ params: { id: ep.id }, props: { ep } }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
const { season, episode, title, date, cliffhanger, medium, sample, drawing } = ep.data;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`S${season} E${episode}: ${title}`} description={cliffhanger}>
  <a class="back" href="/episodes/">All episodes</a>

  <div class:list={['episode', { 'has-board': drawing }]}>
    {drawing && (
      <div class="stage">
        <Whiteboard title={drawing.title} steps={drawing.steps} />
      </div>
    )}

    <article class="text">
      <p class="code">Season {season}, Episode {episode}</p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
        {sample && <span class="sample-tag">Sample, replace me</span>}
      </p>
      <div class="notes"><Content /></div>
      <p class="cliff hand"><span class="cliff-label">Next time:</span> {cliffhanger}</p>
      {medium
        ? <a class="button" href={medium} target="_blank" rel="noopener">Read the full post on Medium</a>
        : <span class="ph">Placeholder: Medium link</span>}
    </article>
  </div>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 28px; color: var(--muted); font-weight: 700; }

  .episode { display: grid; gap: 40px; }
  @media (min-width: 900px) {
    .episode.has-board { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 56px; }
    .stage { position: sticky; top: 24px; }
  }

  .text { display: grid; gap: 16px; justify-items: start; }
  .code { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--muted); }
  .text h1 { font-size: clamp(2rem, 3.6vw, 2.75rem); line-height: 1.02; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; color: var(--muted); font-size: 1rem; }
  .notes { max-width: var(--measure); }
  .notes :global(p + p) { margin-top: 0.8em; }
  .cliff { border-left: 3px solid var(--redline); padding: 2px 0 2px 14px; font-size: 1.25rem; }
  .cliff-label { font-weight: 700; }
</style>
