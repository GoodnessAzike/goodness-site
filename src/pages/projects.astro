---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Pipelines and SQL work, with links to the code on GitHub.">
  <header class="page-head">
    <h1>Projects</h1>
    <p>Pipelines and SQL work. Each one links to the code on GitHub.</p>
  </header>

  <div class="grid">
    {projects.map((p) => (
      <article class="project">
        <div class="top">
          <h2>{p.data.title}</h2>
          {p.data.building && <span class="building">Still building</span>}
          {p.data.sample && <span class="sample-tag">Sample, replace me</span>}
        </div>
        <p>{p.data.summary}</p>
        {p.data.stack.length > 0 && (
          <ul class="stack" aria-label="Tools used">
            {p.data.stack.map((s) => <li>{s}</li>)}
          </ul>
        )}
        <div class="foot">
          {p.data.github
            ? <a class="button" href={p.data.github} target="_blank" rel="noopener">View code on GitHub</a>
            : <span class="ph">Placeholder: GitHub link</span>}
        </div>
      </article>
    ))}
  </div>
  {projects.length === 0 && <p>No projects yet. Add a Markdown file to src/content/projects/ to list one.</p>}
</Base>

<style>
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .project {
    border: 1px solid var(--line);
    border-top: 6px solid var(--line);
    background: var(--ink-raised);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .top { display: grid; gap: 10px; justify-items: start; }
  .project h2 { font-size: 1.75rem; font-weight: 700; line-height: 1.05; }
  .project > p { font-size: 1rem; }
  .building {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 2px 10px; border: 1px solid var(--line);
    font-size: 0.875rem; font-weight: 700; color: var(--paper);
  }
  .building::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--signal); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack li { border: 1px solid var(--line); padding: 2px 10px; font-size: 0.875rem; color: var(--muted); }
  .foot { margin-top: auto; padding-top: 6px; }
</style>
