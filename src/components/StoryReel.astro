---
// About page opening: a 10-second silent "movie" about me. Letterbox, film grain, the baby photo
// pushing in, quick title-card cuts through my milestones, then an end title. Plays once when it
// scrolls into view; "Watch again" replays it. With reduced motion it shows the photo and end title.
import { site } from '../data/site';
import DraftMark from './DraftMark.astro';

const { beats, draft } = site.storyReel;
const total = beats.reduce((n, b) => n + b.ms, 0);
const story = beats.map((b) => b.lines.join(' ')).join(' ') + ` ${site.name}. ${site.tagline}`;
---
<section class="reel-wrap" aria-label="A ten-second film about me">
  <div class="reel" data-reel data-state="idle" role="img" aria-label={story}>
    {beats.map((b, i) => (
      <div class:list={['beat', { photo: !!b.photo }]} data-beat={i} data-ms={b.ms} aria-hidden="true" style={b.ratio ? `--ar:${b.ratio.toFixed(3)}` : undefined}>
        {b.photo && (
          <>
            <img class="ph-bg" src={b.photo} alt="" />
            <span class="print"><img src={b.photo} alt="" /></span>
          </>
        )}
        <div class="cap">
          {b.lines.map((l, j) => <p class:list={['l', `l${j}`]}>{l}</p>)}
        </div>
      </div>
    ))}
    <div class="beat endcard" data-end aria-hidden="true">
      <p class="e-name">{site.name}</p>
      <p class="e-line">{site.tagline}</p>
    </div>
    <i class="grain" aria-hidden="true"></i>
    <i class="bar top" aria-hidden="true"></i><i class="bar bottom" aria-hidden="true"></i>
    <button type="button" class="again" data-again hidden>Watch again</button>
  </div>
  {draft && <DraftMark />}
  <p class="visually-hidden">{story}</p>
</section>

<script>
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const beats = Array.from(reel.querySelectorAll<HTMLElement>('[data-beat]'));
    const end = reel.querySelector<HTMLElement>('[data-end]')!;
    const again = reel.querySelector<HTMLButtonElement>('[data-again]')!;
    let timers: number[] = [];

    const show = (el: HTMLElement | null) => {
      [...beats, end].forEach((b) => b.classList.toggle('on', b === el));
    };
    const play = () => {
      timers.forEach(clearTimeout); timers = [];
      again.hidden = true;
      reel.dataset.state = 'playing';
      let t = 0;
      beats.forEach((b) => {
        timers.push(window.setTimeout(() => show(b), t));
        t += Number(b.dataset.ms);
      });
      timers.push(window.setTimeout(() => { show(end); reel.dataset.state = 'ended'; }, t));
      timers.push(window.setTimeout(() => { again.hidden = false; }, t + 1200));
    };
    again.addEventListener('click', play);

    if (reduce) {
      // no movement: the photo and the end title, side by side in time
      beats[0]?.classList.add('on');
      reel.dataset.state = 'still';
      setTimeout(() => { show(end); again.hidden = true; }, 2500);
    } else {
      show(beats[0] ?? null);
      reel.dataset.state = 'idle';
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play(); }
      }, { threshold: 0.5 });
      io.observe(reel);
    }
  }
</script>

<style>
  .reel-wrap { margin: 0 0 clamp(40px, 7vw, 64px); display: grid; gap: 10px; justify-items: start; }
  .reel {
    position: relative; width: 100%; max-width: 860px; aspect-ratio: 16 / 9;
    background: #050505; overflow: hidden; color: #fff;
    border: 1px solid var(--line);
  }
  @media (max-width: 560px) { .reel { aspect-ratio: 4 / 5; } }

  .beat { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transition: opacity 0.18s linear; }
  .beat.on { opacity: 1; }
  .beat.photo { transition-duration: 0.9s; }

  /* the photo: an old print in the middle of the frame, over a soft blurred copy of itself */
  .ph-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: sepia(0.4) blur(18px) brightness(0.45); transform: scale(1.2);
  }
  .print {
    position: absolute; left: 50%; top: 48%; height: 74%; aspect-ratio: var(--ar, 0.765);
    background: #f1e9d8; padding: 1.6% 1.6% 4.5%;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
    transform: translate(-50%, -50%) rotate(-2.5deg) scale(1);
  }
  .print img { display: block; width: 100%; height: 100%; object-fit: cover; filter: sepia(0.3) contrast(1.05) brightness(0.92); }
  .beat.photo.on .print { animation: push 3.4s ease-out forwards; }
  @keyframes push {
    from { transform: translate(-50%, -50%) rotate(-2.5deg) scale(1); }
    to { transform: translate(-50%, -50%) rotate(-1deg) scale(1.12); }
  }
  /* on wide screens the caption sits beside the print, like a note written next to it */
  @media (min-width: 561px) {
    /* just right of the print, whatever its shape */
    .beat.photo .cap {
      position: absolute; left: calc(52% + 20.8% * var(--ar, 0.765)); bottom: 24%;
      max-width: calc(46% - 20.8% * var(--ar, 0.765)); padding: 0; text-align: left; transform: rotate(-4deg);
    }
    .beat.photo .l { font-size: clamp(1.125rem, 2.4vw, 1.875rem); }
  }
  /* on tall phone screens the photo simply fills the frame */
  @media (max-width: 560px) {
    .ph-bg { filter: sepia(0.35) contrast(1.05) brightness(0.85); transform: none; }
    .print { display: none; }
    .beat.photo.on .ph-bg { animation: push-fill 3.4s ease-out forwards; }
  }
  @keyframes push-fill { from { transform: scale(1.04); } to { transform: scale(1.16); } }

  /* captions and title cards */
  .cap { position: relative; z-index: 2; display: grid; gap: 4px; text-align: center; padding: 0 8%; }
  .l { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 5.4vw, 3.5rem); line-height: 1; letter-spacing: 0.01em; }
  .l1 { color: var(--signal); }
  .beat.on .l { animation: cut-in 0.35s ease-out both; }
  .beat.on .l1 { animation-delay: 0.12s; }
  @keyframes cut-in { from { opacity: 0; transform: translateY(8px); letter-spacing: 0.08em; } to { opacity: 1; transform: none; } }
  /* the photo caption sits low, in red pen */
  .beat.photo { place-items: end center; }
  .beat.photo .cap { padding-bottom: 13%; }
  .beat.photo .l { font-family: var(--font-hand); font-weight: 700; color: #ffb3a8; font-size: clamp(1.375rem, 3.6vw, 2.25rem); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8); }

  .endcard { display: grid; place-content: center; gap: 8px; text-align: center; }
  .e-name { font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 10vw, 6rem); line-height: 0.95; }
  .e-line { font-family: var(--font-hand); font-weight: 700; color: var(--redline); font-size: clamp(1.125rem, 3vw, 1.625rem); }
  .endcard.on .e-name { animation: cut-in 0.6s ease-out both; }
  .endcard.on .e-line { animation: cut-in 0.6s ease-out 0.4s both; }

  /* film grain and letterbox */
  .grain {
    position: absolute; inset: -50%; z-index: 3; pointer-events: none; opacity: 0.18;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.9'/></svg>");
    animation: grain 0.5s steps(4) infinite;
  }
  @keyframes grain { 0% { transform: translate(0, 0); } 25% { transform: translate(-4%, 3%); } 50% { transform: translate(3%, -5%); } 75% { transform: translate(-2%, 4%); } 100% { transform: translate(0, 0); } }
  .bar { position: absolute; left: 0; right: 0; height: 9%; background: #000; z-index: 4; }
  .bar.top { top: 0; }
  .bar.bottom { bottom: 0; }

  .again {
    position: absolute; z-index: 5; right: 14px; bottom: calc(9% + 12px);
    min-height: 44px; padding: 8px 16px;
    border: 1.5px solid rgba(255, 255, 255, 0.7); background: rgba(0, 0, 0, 0.5); color: #fff;
    font: inherit; font-size: 0.9375rem; font-weight: 700; cursor: pointer;
  }
  .again[hidden] { display: none; }
  .again:hover { background: #fff; color: #000; }

  @media (prefers-reduced-motion: reduce) {
    .grain { animation: none; }
    .beat, .beat.photo { transition: none; }
    .beat.photo.on .print, .beat.photo.on .ph-bg, .beat.on .l, .endcard.on .e-name, .endcard.on .e-line { animation: none; }
  }
</style>
