---
// Scenario 2, redrawn from public/diagrams/scenario-2.png as an animated SVG.
// Every label matches the original image. Two layouts: wide (desktop) and tall (phone).

import { wide, tall, head, tagW, PATH } from '../data/scenario2';

const story =
  'Scenario 2, step by step. Inside an AWS account in eu-west-2, a Lambda runs nightly at 22:00 and pulls payments from the last 3 days from the Stripe API. ' +
  'On 26 October it writes raw/payments/2026-10-26.json to the S3 bucket as version 1. Refunds arrive on 27 October and 28 October, so the same file is written again as version 2 and then version 3, each on top of the last. ' +
  'From 28 November, a lifecycle rule with NoncurrentDays 30 has deleted version 1 on 27 November and version 2 on 28 November. Version 3, the current one, stays.';

const layouts = [wide, tall];
---
<figure class="s2" data-s2 data-step="1">
  <div class="panel">
    {layouts.map((L) => (
      <svg class={`v-${L.key}`} viewBox={L.viewBox} role="img" aria-label={story}>
        <!-- AWS ACCOUNT frame -->
        <rect class="account" x={L.account.x} y={L.account.y} width={L.account.w} height={L.account.h} rx="12" />
        <rect class="tag-bg" x={L.account.tag[0] - 6} y={L.account.tag[1] - L.fs.tag * 0.75} width={tagW('AWS ACCOUNT · eu-west-2', L.fs.tag)} height={L.fs.tag * 1.5} />
        <text class="tag t-account" x={L.account.tag[0]} y={L.account.tag[1] + L.fs.tag * 0.36} font-size={L.fs.tag}>AWS ACCOUNT · eu-west-2</text>

        <!-- OUTBOUND frame with Stripe API -->
        <rect class="outbound" x={L.outbound.x} y={L.outbound.y} width={L.outbound.w} height={L.outbound.h} rx="10" />
        <rect class="tag-bg" x={L.outbound.tag[0] - 6} y={L.outbound.tag[1] - L.fs.tag * 0.75} width={tagW('OUTBOUND', L.fs.tag)} height={L.fs.tag * 1.5} />
        <text class="tag t-outbound" x={L.outbound.tag[0]} y={L.outbound.tag[1] + L.fs.tag * 0.36} font-size={L.fs.tag}>OUTBOUND</text>
        <g transform={`translate(${L.stripe.x} ${L.stripe.y}) scale(${L.stripe.s / 52})`}>
          <rect width="52" height="52" rx="9" fill="#545b64" />
          <rect x="14" y="14.5" width="24" height="9.5" rx="2.5" fill="none" stroke="#fff" stroke-width="2" />
          <rect x="14" y="28" width="24" height="9.5" rx="2.5" fill="none" stroke="#fff" stroke-width="2" />
          <circle cx="19" cy="19.25" r="1.5" fill="#fff" />
          <circle cx="19" cy="32.75" r="1.5" fill="#fff" />
        </g>
        <text class="bold" x={L.stripe.text[0]} y={L.stripe.text[1]} font-size={L.fs.bold} text-anchor="middle">Stripe API</text>
        <text class="mono" x={L.stripe.text[0]} y={L.stripe.text[2]} font-size={L.fs.mono} text-anchor="middle">payments, last 3 days</text>

        <!-- step 1: payments flow down to Lambda -->
        <g class="part" data-step="1">
          <path class="arrow" d={L.pay.d} />
          <path class="pulse" d={L.pay.d} />
          <polygon class="head" points={head(L.pay.end, L.pay.dir)} />
          <text class="mono" x={L.pay.label[0]} y={L.pay.label[1]} font-size={L.fs.mono} text-anchor="end">payments</text>
        </g>

        <!-- Lambda -->
        <g transform={`translate(${L.lambda.x} ${L.lambda.y}) scale(${L.lambda.s / 52})`}>
          <rect width="52" height="52" rx="9" fill="#ed7100" />
          <path d="M17 40 L24.5 24 M19.5 13 H25 L35.5 40" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text class="bold" x={L.lambda.text[0]} y={L.lambda.text[1]} font-size={L.fs.bold} text-anchor="middle">Lambda</text>
        <text class="mono" x={L.lambda.text[0]} y={L.lambda.text[2]} font-size={L.fs.mono} text-anchor="middle">nightly, 22:00</text>

        <!-- S3 BUCKET · 28 OCTOBER -->
        <g class="left-bucket">
          <rect class="bucket" x={L.bucketL.x} y={L.bucketL.y} width={L.bucketL.w} height={L.bucketL.h} rx="10" />
          <rect class="tag-bg" x={L.bucketL.tag[0] - 6} y={L.bucketL.tag[1] - L.fs.tag * 0.75} width={tagW('S3 BUCKET · 28 OCTOBER', L.fs.tag)} height={L.fs.tag * 1.5} />
          <text class="tag t-bucket" x={L.bucketL.tag[0]} y={L.bucketL.tag[1] + L.fs.tag * 0.36} font-size={L.fs.tag}>S3 BUCKET · 28 OCTOBER</text>

          {L.writes.map((w) => (
            <g class="part" data-step={w.step}>
              <path class="arrow" d={w.d} />
              <path class="pulse" d={w.d} />
              <polygon class="head" points={head(w.end, w.dir)} />
              <circle class="badge" cx={w.badge[0]} cy={w.badge[1]} r={L.fs.mono * 0.72} />
              <text class="badge-n" x={w.badge[0]} y={w.badge[1] + L.fs.mono * 0.36} font-size={L.fs.mono * 0.95} text-anchor="middle">{w.n}</text>
              <text class="mono" x={w.badge[0] + L.fs.mono * 1.25} y={w.badge[1] + L.fs.mono * 0.36} font-size={L.fs.mono} text-anchor={w.anchor}>{w.text}</text>
            </g>
          ))}

          {L.versionsL.map((v) => (
            <g class="part version" data-step={v.step}>
              <rect class="v-alive" x={v.x} y={v.y} width={v.w} height={v.h} rx="9" />
              <text class="bold" x={v.x + v.w / 2} y={v.y + v.h / 2 + L.fs.bold * 0.35} font-size={L.fs.bold} text-anchor="middle">{v.lines[0]}</text>
            </g>
          ))}
          <text class="part mono" data-step="2" x={L.pathL[0]} y={L.pathL[1]} font-size={L.fs.mono} text-anchor="middle">{PATH}</text>
        </g>

        <!-- step 5: lifecycle rule and S3 BUCKET · FROM 28 NOVEMBER -->
        <g class="part" data-step="5">
          <rect class="lifecycle" x={L.lifecycle.x} y={L.lifecycle.y} width={L.lifecycle.w} height={L.lifecycle.h} rx="10" />
          <text class="bold" x={L.lifecycle.x + L.lifecycle.w / 2} y={L.lifecycle.y + L.lifecycle.h / 2 - 2} font-size={L.fs.bold} text-anchor="middle">Lifecycle rule</text>
          <text class="sub" x={L.lifecycle.x + L.lifecycle.w / 2} y={L.lifecycle.y + L.lifecycle.h / 2 + L.fs.mono + 3} font-size={L.fs.mono} text-anchor="middle">NoncurrentDays 30</text>

          <rect class="bucket" x={L.bucketR.x} y={L.bucketR.y} width={L.bucketR.w} height={L.bucketR.h} rx="10" />
          <rect class="tag-bg" x={L.bucketR.tag[0] - 6} y={L.bucketR.tag[1] - L.fs.tag * 0.75} width={tagW('S3 BUCKET · FROM 28 NOVEMBER', L.fs.tag)} height={L.fs.tag * 1.5} />
          <text class="tag t-bucket" x={L.bucketR.tag[0]} y={L.bucketR.tag[1] + L.fs.tag * 0.36} font-size={L.fs.tag}>S3 BUCKET · FROM 28 NOVEMBER</text>

          {L.lcArrows.map((a) => (
            <g>
              <path class="arrow" d={a.d} />
              <path class="pulse" d={a.d} />
              <polygon class="head" points={head(a.end, a.dir)} />
            </g>
          ))}

          {L.versionsR.map((v) => (
            <g class:list={['version', { deletable: v.deleted }]}>
              <rect class="v-alive" x={v.x} y={v.y} width={v.w} height={v.h} rx="9" />
              {v.deleted && <rect class="v-dead" x={v.x} y={v.y} width={v.w} height={v.h} rx="9" />}
              <text class="bold v-label" x={v.x + v.w / 2} y={v.y + v.h / 2 + L.fs.bold * 0.35 - ((v.lines.length - 1) * L.fs.bold * 1.2) / 2} font-size={L.fs.bold} text-anchor="middle">
                {v.lines.map((l, j) => <tspan x={v.x + v.w / 2} dy={j === 0 ? 0 : L.fs.bold * 1.2}>{l}</tspan>)}
              </text>
            </g>
          ))}
          <text class="mono" x={L.pathR[0]} y={L.pathR[1]} font-size={L.fs.mono} text-anchor="middle">{PATH}</text>
        </g>
      </svg>
    ))}
  </div>

  <figcaption class="log">
    <ol class="ticks" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((n) => <li data-tick={n}></li>)}
    </ol>
    <p class="caption" aria-live="polite" data-caption>Stripe API sends payments (last 3 days) down to Lambda (nightly, 22:00).</p>
  </figcaption>

  <div class="controls" role="group" aria-label="Animation controls">
    <button type="button" data-play>Play</button>
    <button type="button" data-pause>Pause</button>
    <button type="button" data-next>Next step</button>
    <button type="button" data-replay>Replay</button>
  </div>
</figure>

<script>
  const CAPTIONS = [
    'Stripe API sends payments (last 3 days) down to Lambda (nightly, 22:00).',
    'Step 1: Lambda writes version 1 to the S3 bucket on 26 Oct.',
    'Step 2: refunds arrive on 27 Oct, so version 2 appears.',
    'Step 3: refunds arrive on 28 Oct, so version 3 appears.',
    'From 28 November: the lifecycle rule (NoncurrentDays 30) deletes version 1 (27 Nov) and version 2 (28 Nov). Version 3 stays.',
  ];
  const LAST = CAPTIONS.length;
  const HOLD = 3800; // ms per step while playing

  const fig = document.querySelector<HTMLElement>('[data-s2]');
  if (fig) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const caption = fig.querySelector<HTMLElement>('[data-caption]')!;
    const btn = {
      play: fig.querySelector<HTMLButtonElement>('[data-play]')!,
      pause: fig.querySelector<HTMLButtonElement>('[data-pause]')!,
      next: fig.querySelector<HTMLButtonElement>('[data-next]')!,
      replay: fig.querySelector<HTMLButtonElement>('[data-replay]')!,
    };
    let step = 1;
    let timer: number | undefined;

    // Measure arrow lengths on the visible layout so lines can draw themselves
    const measure = () => {
      fig.querySelectorAll<SVGPathElement>('.arrow').forEach((p) => {
        const len = p.getTotalLength();
        if (len > 0) p.style.setProperty('--len', `${len}`);
      });
    };

    const render = () => {
      fig.dataset.step = String(step);
      fig.querySelectorAll<SVGElement>('[data-step]').forEach((el) => {
        const n = Number(el.dataset.step);
        el.classList.toggle('on', n <= step);
        el.classList.toggle('current', n === step);
      });
      fig.querySelectorAll<HTMLElement>('[data-tick]').forEach((t) => {
        t.classList.toggle('done', Number(t.dataset.tick) <= step);
      });
      caption.textContent = CAPTIONS[step - 1];
      btn.next.disabled = step >= LAST;
    };

    const setPlaying = (on: boolean) => {
      fig.classList.toggle('playing', on);
      btn.play.disabled = on;
      btn.pause.disabled = !on;
    };

    const stop = () => { window.clearInterval(timer); timer = undefined; setPlaying(false); };
    const play = () => {
      if (step >= LAST) step = 0;
      if (step === 0) { step = 1; render(); }
      setPlaying(true);
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        if (step >= LAST) return stop();
        step++;
        render();
        if (step >= LAST) stop();
      }, HOLD);
    };

    btn.play.addEventListener('click', play);
    btn.pause.addEventListener('click', stop);
    btn.next.addEventListener('click', () => { stop(); if (step < LAST) { step++; render(); } });
    btn.replay.addEventListener('click', () => { stop(); step = 1; render(); play(); });

    measure();
    window.addEventListener('resize', measure);
    render();
    setPlaying(false);

    // Start playing once the diagram is on screen (not when motion is reduced)
    if (!reduce) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play(); }
      }, { threshold: 0.4 });
      io.observe(fig);
    }
  }
</script>

<style>
  .s2 {
    margin: 0;
    --c-account: #e0954a;
    --c-bucket: #6f9fe6;
    --c-alive-fill: #22381f;
    --c-alive: #93c45a;
    --c-dead: #71849a;
    --c-rule-fill: #1b2f52;
    --c-arrow: #9db1c8;
    --c-badge: #3d7be6;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .panel {
    border: 1px solid var(--line);
    background: var(--ink-raised);
    padding: clamp(8px, 2vw, 20px);
  }
  svg { display: block; width: 100%; height: auto; }
  .v-tall { display: none; }
  @media (max-width: 720px) {
    .v-wide { display: none; }
    .v-tall { display: block; }
  }

  /* static frames */
  .account { fill: none; stroke: var(--c-account); stroke-width: 1.6; }
  .outbound { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-dasharray: 6 5; }
  .bucket { fill: none; stroke: var(--c-bucket); stroke-width: 1.6; stroke-dasharray: 6 5; }
  .tag-bg { fill: var(--ink-raised); }
  .tag { font-family: var(--mono); font-weight: 700; letter-spacing: 0.04em; }
  .t-account { fill: var(--c-account); }
  .t-outbound { fill: var(--muted); }
  .t-bucket { fill: var(--c-bucket); }
  .bold { font-family: var(--font-body); font-weight: 700; fill: var(--paper); }
  .mono { font-family: var(--mono); fill: var(--muted); }
  .sub { font-family: var(--font-body); fill: var(--muted); }
  .lifecycle { fill: var(--c-rule-fill); stroke: var(--c-bucket); stroke-width: 1.8; }

  .v-alive { fill: var(--c-alive-fill); stroke: var(--c-alive); stroke-width: 1.8; }
  .v-dead { fill: none; stroke: var(--c-dead); stroke-width: 1.6; stroke-dasharray: 6 5; opacity: 0; }

  /* arrows draw themselves; dots travel along the current one */
  .arrow {
    fill: none; stroke: var(--c-arrow); stroke-width: 1.8;
    stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0);
    transition: stroke-dashoffset 0.9s ease-out;
  }
  .on .arrow { stroke-dashoffset: 0; }
  .head { fill: var(--c-arrow); opacity: 0; transition: opacity 0.2s 0.8s; }
  .on .head { opacity: 1; }
  .pulse { fill: none; stroke: var(--signal); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 0.1 14; opacity: 0; }
  .current .pulse { opacity: 1; animation: flow 0.9s linear infinite; animation-delay: 0.9s; }
  @keyframes flow { to { stroke-dashoffset: -14.1; } }
  .badge { fill: var(--c-badge); }
  .badge-n { font-family: var(--font-body); font-weight: 700; fill: #fff; }

  /* parts fade in when their step arrives */
  .part { opacity: 0; transition: opacity 0.5s ease-out; }
  .part.on { opacity: 1; }
  .version.part { transform-box: fill-box; transform-origin: center; transform: scale(0.9); transition: opacity 0.5s 0.6s, transform 0.5s 0.6s cubic-bezier(0.2, 1.4, 0.4, 1); }
  .version.part.on { transform: none; }

  /* step 5: the October bucket steps back; versions 1 and 2 fade to deleted */
  .left-bucket { transition: opacity 0.6s; }
  [data-step='5'] .left-bucket { opacity: 0.35; }
  .deletable .v-alive, .deletable .v-dead, .deletable .v-label { transition: opacity 0.8s 1.6s, fill 0.8s 1.6s; }
  .on .deletable .v-alive { opacity: 0; }
  .on .deletable .v-dead { opacity: 1; }
  .on .deletable .v-label { fill: var(--c-dead); }

  /* caption strip */
  .log {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    border: 1px solid var(--line);
    border-top: 0;
    padding: 14px clamp(14px, 2vw, 20px);
    min-height: 72px;
  }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; gap: 5px; }
  .ticks li { width: 10px; height: 22px; background: var(--signal-ghost); }
  .ticks li.done { background: var(--signal); }
  .caption { font-size: 1.0625rem; max-width: none; }
  @media (max-width: 520px) { .log { grid-template-columns: 1fr; gap: 10px; } }

  .controls { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .controls button {
    min-height: 44px; padding: 8px 16px;
    border: 1.5px solid var(--line); background: transparent; color: var(--paper);
    font: inherit; font-size: 1rem; font-weight: 700; cursor: pointer;
  }
  .controls button:hover:not(:disabled) { border-color: var(--paper); }
  .controls button:disabled { opacity: 0.4; cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .arrow { stroke-dasharray: none; }
    .pulse { display: none; }
    .version.part { transform: none; }
  }
</style>
