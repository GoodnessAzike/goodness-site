---
// "What people say": a strip of real quotes sliding slowly across the page.
// Pauses when hovered or focused. With reduced motion, the quotes sit still in a list.
import { testimonials } from '../data/testimonials';
import Placeholder from './Placeholder.astro';

const show = testimonials.length > 0;
const visible = show || import.meta.env.DEV;
// Repeat short lists so the strip is long enough to loop smoothly
const loop = show ? Array.from({ length: Math.max(2, Math.ceil(6 / testimonials.length)) }, () => testimonials).flat() : [];
---
{visible && (
  <section class="said" aria-labelledby="said-title">
    <h2 id="said-title">What people say</h2>
    {show ? (
      <div class="strip" tabindex="0" aria-label="Quotes about Goodness. Hover or focus to pause.">
        <ul class="track">
          {[0, 1].map((copy) => loop.map((t) => (
            <li class="card" aria-hidden={copy === 1 ? 'true' : undefined}>
              <blockquote><p>{t.quote}</p></blockquote>
              <p class="who"><strong>{t.name}</strong>{t.role && <span>{t.role}</span>}{t.source && <span class="src">{t.source}</span>}</p>
            </li>
          )))}
        </ul>
      </div>
    ) : (
      <Placeholder block>real quotes about you (from LinkedIn recommendations, managers, mentees), with each person's OK. Add them in src/data/testimonials.ts.</Placeholder>
    )}
  </section>
)}

<style>
  .said { margin-top: clamp(64px, 10vw, 112px); display: grid; gap: 24px; }
  .strip {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 22px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: 20px; width: max-content;
    animation: slide 60s linear infinite;
  }
  .strip:hover .track, .strip:focus-within .track, .strip:focus .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 10px)); } }

  .card {
    width: min(78vw, 380px);
    border: 1px solid var(--line);
    background: var(--ink-raised);
    padding: 20px 22px;
    display: grid; gap: 14px; align-content: space-between;
  }
  .card blockquote { margin: 0; }
  .card blockquote p { font-size: 1.0625rem; line-height: 1.5; }
  .card blockquote p::before { content: '“'; color: var(--signal); font-family: var(--font-display); font-size: 2rem; line-height: 0; vertical-align: -0.35em; margin-right: 4px; }
  .who { display: grid; gap: 2px; font-size: 0.9375rem; color: var(--muted); }
  .who strong { color: var(--paper); }
  .src { font-family: var(--font-hand); color: var(--redline); }

  @media (prefers-reduced-motion: reduce) {
    .strip { -webkit-mask-image: none; mask-image: none; overflow: visible; }
    .track { animation: none; width: auto; flex-wrap: wrap; }
    .card[aria-hidden='true'] { display: none; }
  }
</style>
